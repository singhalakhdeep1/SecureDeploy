# --- Backend (backend/.env) ---
DATABASE_URL=postgresql://securedeploy:securedeploy_password@localhost:5432/securedeploy
# Redis: either REDIS_URL or REDIS_HOST/REDIS_PORT. Optional; cache and rate limiter fail open without it.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-to-at-least-16-random-characters
JWT_EXPIRES_IN=8h
# Shared secret for /api/webhooks/* (CI pipelines, scanner CronJobs)
WEBHOOK_SECRET=change-me-webhook-secret
PORT=3001
FRONTEND_URL=http://localhost:3000
BODY_LIMIT=25mb
RATE_LIMIT_PER_MINUTE=100

# Deployment gate: open CRITICAL findings always block; set >= 0 to also block above N open HIGH findings
DEPLOY_MAX_HIGH_FINDINGS=-1

# Cache / rate limiting / resilience (HLD patterns)
CACHE_TTL_SECONDS=60
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=1
ERROR_HANDLING_RETRY_COUNT=3
ERROR_HANDLING_EXCEPTIONS_BEFORE_BREAKING=5
ERROR_HANDLING_BREAK_DURATION=60000
ERROR_HANDLING_TIMEOUT=30000
SCAN_TIMEOUT_MS=600000

# Seed (npm run prisma:seed)
SEED_PASSWORD=ChangeMe123!

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
